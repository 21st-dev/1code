{
  "name": "locus",
  "version": "0.0.80",
  "private": true,
  "description": "Local-first AI workbench and agent runtime hub",
  "homepage": "https://github.com/lupanpan1030/agent-code-for-me",
  "author": {
    "name": "Locus"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/ensure-electron-native-modules.mjs && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder --dir",
    "package:mac": "electron-builder --mac",
    "package:win": "node scripts/assert-release-host.mjs --platform=win32 && electron-builder --win",
    "package:linux": "electron-builder --linux",
    "dist": "electron-builder",
    "release:manifest": "node scripts/generate-update-manifest.mjs",
    "release:smoke:mac": "node scripts/smoke-macos-release.mjs",
    "release:upload": "echo \"Upload Locus release artifacts manually through GitHub Releases\"",
    "dist:manifest": "bun run release:manifest",
    "dist:upload": "bun run release:upload",
    "claude:download": "node scripts/download-claude-binary.mjs --version=2.1.177",
    "claude:download:all": "node scripts/download-claude-binary.mjs --version=2.1.177 --all",
    "codex:download": "node scripts/download-codex-binary.mjs --version=0.139.0",
    "codex:download:all": "node scripts/download-codex-binary.mjs --version=0.139.0 --all",
    "release:clean": "node scripts/clean-release-dir.mjs",
    "release": "bun run release:mac",
    "release:mac": "node scripts/assert-release-host.mjs --platform=darwin && bun run release:clean && bun i && bun run claude:download && bun run codex:download && bun run build && bun run native:check && bun run package:mac && bun run release:manifest",
    "release:win": "node scripts/assert-release-host.mjs --platform=win32 && bun run release:clean && bun i && bun run claude:download && bun run codex:download && bun run build && bun run native:check && bun run package:win && bun run release:manifest",
    "release:dev": "bun run release:clean && bun run claude:download && bun run codex:download && bun run build && bun run package:mac && bun run release:manifest && rm -rf node_modules && bun i",
    "sync:public": "echo \"Upstream sync is disabled for Locus\"",
    "icon:generate": "node scripts/generate-icon.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "bun run lint:changed",
    "lint:changed": "node scripts/run-biome-changed.mjs",
    "lint:all": "biome check .",
    "format": "biome format --write .",
    "test": "bun test --isolate tests",
    "architecture:check": "node scripts/check-architecture-guards.mjs",
    "runtime-control:smoke:evidence": "node scripts/check-runtime-control-smoke-evidence.mjs",
    "runtime-control:smoke:job": "node scripts/inspect-runtime-control-smoke-job.mjs",
    "mcp-registry:proof:evidence": "node scripts/check-mcp-registry-proof-evidence.mjs",
    "settings-ia:smoke:evidence": "node scripts/check-settings-ia-smoke-evidence.mjs",
    "qwen-acp:smoke:evidence": "node scripts/check-qwen-acp-smoke-evidence.mjs",
    "check": "bun run lint && bun run architecture:check && bun run ts:check && bun run test",
    "ts:check": "tsc --noEmit",
    "native:check": "node scripts/ensure-electron-native-modules.mjs --check-only",
    "native:rebuild": "node scripts/ensure-electron-native-modules.mjs --force",
    "postinstall": "node scripts/ensure-electron-native-modules.mjs --force && node scripts/patch-electron-dev.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.4.9",
    "@ai-sdk/react": "^3.0.14",
    "@anthropic-ai/claude-agent-sdk": "0.3.177",
    "@mcpc-tech/acp-ai-provider": "^0.2.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@pierre/diffs": "^1.0.10",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "1.2.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.10",
    "@tanstack/react-virtual": "^3.13.18",
    "@trpc/client": "^11.7.1",
    "@trpc/react-query": "^11.7.1",
    "@trpc/server": "^11.7.1",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "ai": "^6.0.14",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^12.6.2",
    "builder-util-runtime": "9.2.10",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^8.0.3",
    "dompurify": "^3.4.11",
    "drizzle-orm": "^0.45.1",
    "electron-updater": "^6.8.3",
    "jotai": "^2.11.1",
    "js-yaml": "^4.1.0",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.12.2",
    "monaco-editor": "^0.55.1",
    "motion": "^11.15.0",
    "next-themes": "^0.4.4",
    "node-pty": "^1.1.0",
    "pidtree": "^0.6.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hotkeys-hook": "^4.6.1",
    "react-icons": "^5.5.0",
    "react-zoom-pan-pinch": "^3.7.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^1.24.4",
    "simple-git": "^3.28.0",
    "sonner": "^1.7.1",
    "streamdown": "^2.0.1",
    "superjson": "^2.2.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "trpc-electron": "^0.1.2",
    "unique-names-generator": "^4.7.1",
    "xterm": "^5.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@electron/rebuild": "^4.0.3",
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/hast": "3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.17.50",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@welldone-software/why-did-you-render": "^10.0.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.8",
    "electron": "~39.4.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "happy-dom": "^20.10.6",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.5",
    "vite": "^6.3.4"
  },
  "build": {
    "appId": "io.github.lupanpan1030.locus",
    "productName": "Locus",
    "npmRebuild": true,
    "publish": [
      {
        "provider": "github",
        "owner": "lupanpan1030",
        "repo": "agent-code-for-me"
      }
    ],
    "protocols": [
      {
        "name": "Locus",
        "schemes": [
          "locus",
          "agent-code-for-me"
        ]
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "drizzle",
        "to": "migrations"
      },
      {
        "from": "resources/bin/${platform}-${arch}",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/bin/VERSION",
        "to": "bin/VERSION"
      },
      {
        "from": "resources/cli",
        "to": "cli",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/skill-registry",
        "to": "skill-registry",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/node-pty/**/*",
      "node_modules/@anthropic-ai/claude-agent-sdk/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Locus needs microphone access for voice dictation"
      }
    },
    "dmg": {
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 150,
          "type": "file"
        },
        {
          "x": 400,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "iconSize": 80
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Development"
    },
    "nsis": {
      "artifactName": "Locus-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Locus-${version}-portable.${ext}"
    }
  },
  "pnpm": {
    "overrides": {
      "source-map-support>source-map": "0.7.4"
    }
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
