#!/bin/bash
# 1code compatibility CLI launcher
# Opens Agent Code for Me with the specified directory

# Resolve the directory argument (default to current directory)
DIR="${1:-.}"

# Convert to absolute path
if [[ "$DIR" != /* ]]; then
  DIR="$(cd "$DIR" 2>/dev/null && pwd)"
fi

if [ -z "$DIR" ] || [ ! -d "$DIR" ]; then
  echo "Error: Invalid directory"
  exit 1
fi

# Open Agent Code for Me with the directory argument
open -a "Agent Code for Me" --args "$DIR"
