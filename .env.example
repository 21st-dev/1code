# =============================================================================
# Local-First Build Configuration
# =============================================================================
# The default desktop app works without this file.
# Copy values into `.env` only for local development, signing, or optional
# user-owned integrations. Hosted upstream auth, telemetry, and update services
# are not part of the default Agent Code for Me build.
# =============================================================================

# macOS signing and notarization.
# Skip these for local development or unsigned internal builds.
APPLE_ID=your-email@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_IDENTITY=Developer ID Application: Your Name (TEAM_ID)

# Feedback URL.
# Defaults to this fork's GitHub Issues when unset.
# VITE_FEEDBACK_URL=https://github.com/lupanpan1030/agent-code-for-me/issues

# Voice input.
# Configure voice transcription in Settings > Models > Helper APIs.
# Provider credentials are stored through main-process secure storage; the
# default local-first build has no renderer/env API-key fallback.

# Local-only guard.
# Enabled by default. Set one of these only for internal compatibility testing
# of hosted paths; do not use them for normal local-first builds.
# AGENT_CODE_FOR_ME_LOCAL_ONLY=false
# MAIN_VITE_LOCAL_ONLY=false
